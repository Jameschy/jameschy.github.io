ight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}",{"title":8,"searchDepth":90,"depth":90,"links":91},3,[92],{"id":35,"depth":93,"text":35},2,"markdown","content:articles:hello-nuxt4.md","content","articles\u002Fhello-nuxt4.md","articles\u002Fhello-nuxt4","md",{"_path":101,"_dir":6,"_draft":7,"_partial":7,"_locale":8,"title":102,"description":103,"date":11,"tags":104,"body":111,"_type":94,"_id":654,"_source":96,"_file":655,"_stem":656,"_extension":99},"\u002Farticles\u002Fwindowslinux","如何将Windows电脑改为Linux服务器？","本地办公电脑闲置，可以改造成Linux服务器用于本地开发备份数据，是再好不过了。",[105,106,107,108,109,110],"Linux","服务器","运维","Nginx","Docker","Shell",{"type":16,"children":112,"toc":651},[113,118,619,624,638,647],{"type":19,"tag":20,"props":114,"children":116},{"id":115},"如何将windows电脑改为linux服务器",[117],{"type":25,"value":102},{"type":19,"tag":119,"props":120,"children":125},"div",{"id":121,"className":122},"cnblogs_post_body",[123,124],"blogpost-body","blogpost-body-html",[126,130,135,140,145,150,155,160,170,175,180,187,192,199,204,211,216,223,228,233,238,243,250,255,262,267,274,279,286,291,298,303,310,315,322,327,334,339,346,351,358,363,370,375,382,387,394,399,406,411,418,423,430,443,450,463,475,480,487,499,516,521,528,533,545,559,572,585,603],{"type":19,"tag":27,"props":127,"children":128},{},[129],{"type":25,"value":103},{"type":19,"tag":27,"props":131,"children":132},{},[133],{"type":25,"value":134},"准备如下：",{"type":19,"tag":27,"props":136,"children":137},{},[138],{"type":25,"value":139},"1.一个办公电脑，假设为A，内存不低于8g，硬盘不小于100g，网络网段都在192.168.1.*（用作即将改造为Linux服务器）；",{"type":19,"tag":27,"props":141,"children":142},{},[143],{"type":25,"value":144},"2.一个U盘，假设为B，不小于8g，（用于制作启动盘）",{"type":19,"tag":27,"props":146,"children":147},{},[148],{"type":25,"value":149},"3.一个正常使用的电脑，假设为C，能联网打开等（用于本地操作制作启动盘，及开发、连接本地服务器）",{"type":19,"tag":27,"props":151,"children":152},{},[153],{"type":25,"value":154},"步骤如下：",{"type":19,"tag":27,"props":156,"children":157},{},[158],{"type":25,"value":159},"1.使用设备C，格式化U盘，并下载Rufus 启动盘制作工具,该工具下载后，开箱即用，不必安装，所以必须将此工具置于C设备中（桌面即可），",{"type":19,"tag":27,"props":161,"children":162},{},[163],{"type":19,"tag":164,"props":165,"children":169},"img",{"src":166,"alt":167,"loading":168},"https:\u002F\u002Fimg2024.cnblogs.com\u002Fblog\u002F962554\u002F202606\u002F962554-20260624120808194-714321525.png","image","lazy",[],{"type":19,"tag":27,"props":171,"children":172},{},[173],{"type":25,"value":174},"2.打开Rufus工具，设备栏会自动识别U盘设备，引导类型选择，在后方的选择按钮点击后，选择下载的镜像即可。",{"type":19,"tag":27,"props":176,"children":177},{},[178],{"type":25,"value":179},"下载镜像地址： Rockylinux:https:\u002F\u002Frockylinux.org\u002Fzh-CN\u002Fdownload",{"type":19,"tag":27,"props":181,"children":182},{},[183],{"type":19,"tag":164,"props":184,"children":186},{"src":185,"alt":167,"loading":168},"https:\u002F\u002Fimg2024.cnblogs.com\u002Fblog\u002F962554\u002F202606\u002F962554-20260624113611639-1950242643.png",[],{"type":19,"tag":27,"props":188,"children":189},{},[190],{"type":25,"value":191},"3.点击开始后，弹出提示框，选择默认项——以ISO镜像 模式写入（推荐），即可",{"type":19,"tag":27,"props":193,"children":194},{},[195],{"type":19,"tag":164,"props":196,"children":198},{"src":197,"alt":167,"loading":168},"https:\u002F\u002Fimg2024.cnblogs.com\u002Fblog\u002F962554\u002F202606\u002F962554-20260624121000980-930338554.png",[],{"type":19,"tag":27,"props":200,"children":201},{},[202],{"type":25,"value":203}," 4.继续弹出弹窗，提示会删除U盘设备的所有数据，点击是，继续执行即可",{"type":19,"tag":27,"props":205,"children":206},{},[207],{"type":19,"tag":164,"props":208,"children":210},{"src":209,"alt":167,"loading":168},"https:\u002F\u002Fimg2024.cnblogs.com\u002Fblog\u002F962554\u002F202606\u002F962554-20260624121259748-1471777684.png",[],{"type":19,"tag":27,"props":212,"children":213},{},[214],{"type":25,"value":215}," 5.如下，镜像复制成功后，即代表U盘启动盘做好了。",{"type":19,"tag":27,"props":217,"children":218},{},[219],{"type":19,"tag":164,"props":220,"children":222},{"src":221,"alt":167,"loading":168},"https:\u002F\u002Fimg2024.cnblogs.com\u002Fblog\u002F962554\u002F202606\u002F962554-20260624122617569-1495806379.png",[],{"type":19,"tag":27,"props":224,"children":225},{},[226],{"type":25,"value":227}," 二，改造工作电脑为本地Linux服务器步骤：",{"type":19,"tag":27,"props":229,"children":230},{},[231],{"type":25,"value":232},"1.将启动U盘插到主机后方的蓝色USB接口（3.0，读取较容易）",{"type":19,"tag":27,"props":234,"children":235},{},[236],{"type":25,"value":237},"2.开机A电脑，按F2或F12或F8，不同主板，BIOS的键不一样，打开BIOS选项，选择U盘名称，如Kingston ***，即表示即将进读取磁盘内容",{"type":19,"tag":27,"props":239,"children":240},{},[241],{"type":25,"value":242},"3.进入后选择第三个：*Install Rocky Linux Minimal 9.8 in FIPS mode",{"type":19,"tag":27,"props":244,"children":245},{},[246],{"type":19,"tag":164,"props":247,"children":249},{"src":248,"alt":167,"loading":168},"https:\u002F\u002Fimg2024.cnblogs.com\u002Fblog\u002F962554\u002F202606\u002F962554-20260624133854132-631355725.png",[],{"type":19,"tag":27,"props":251,"children":252},{},[253],{"type":25,"value":254}," 4.回车后，立即进行安装流程：",{"type":19,"tag":27,"props":256,"children":257},{},[258],{"type":19,"tag":164,"props":259,"children":261},{"src":260,"alt":167,"loading":168},"https:\u002F\u002Fimg2024.cnblogs.com\u002Fblog\u002F962554\u002F202606\u002F962554-20260624134240008-2028020073.png",[],{"type":19,"tag":27,"props":263,"children":264},{},[265],{"type":25,"value":266}," 5.完成安装后，进入语言选项配置：选择中文，简体中文即可",{"type":19,"tag":27,"props":268,"children":269},{},[270],{"type":19,"tag":164,"props":271,"children":273},{"src":272,"alt":167,"loading":168},"https:\u002F\u002Fimg2024.cnblogs.com\u002Fblog\u002F962554\u002F202606\u002F962554-20260624134318352-1181883597.png",[],{"type":19,"tag":27,"props":275,"children":276},{},[277],{"type":25,"value":278},"6.选择语言后，弹出设置面板，按图设置好。",{"type":19,"tag":27,"props":280,"children":281},{},[282],{"type":19,"tag":164,"props":283,"children":285},{"src":284,"alt":167,"loading":168},"https:\u002F\u002Fimg2024.cnblogs.com\u002Fblog\u002F962554\u002F202606\u002F962554-20260624140542666-1074187330.png",[],{"type":19,"tag":27,"props":287,"children":288},{},[289],{"type":25,"value":290}," 7.其中第三项，安装目标位置，可按以下设置，默认自动即可：",{"type":19,"tag":27,"props":292,"children":293},{},[294],{"type":19,"tag":164,"props":295,"children":297},{"src":296,"alt":167,"loading":168},"https:\u002F\u002Fimg2024.cnblogs.com\u002Fblog\u002F962554\u002F202606\u002F962554-20260624140742956-1379778229.png",[],{"type":19,"tag":27,"props":299,"children":300},{},[301],{"type":25,"value":302}," 8.如果所选区域，选定后提示：磁盘空间不足，且弹出以下弹窗，点击回收空间即可：",{"type":19,"tag":27,"props":304,"children":305},{},[306],{"type":19,"tag":164,"props":307,"children":309},{"src":308,"alt":167,"loading":168},"https:\u002F\u002Fimg2024.cnblogs.com\u002Fblog\u002F962554\u002F202606\u002F962554-20260624141007357-424204497.png",[],{"type":19,"tag":27,"props":311,"children":312},{},[313],{"type":25,"value":314}," 9.回收空间的意思，表示从安装的设备磁盘中，找出可用空间，但因为不在乎之前的办公Windows系统，直接全选磁盘即可，再点击全部删除，即可回收空间：",{"type":19,"tag":27,"props":316,"children":317},{},[318],{"type":19,"tag":164,"props":319,"children":321},{"src":320,"alt":167,"loading":168},"https:\u002F\u002Fimg2024.cnblogs.com\u002Fblog\u002F962554\u002F202606\u002F962554-20260624141133279-1548853187.png",[],{"type":19,"tag":27,"props":323,"children":324},{},[325],{"type":25,"value":326}," 10.又会回到设置界面，点击用户设置下，设置root密码，另外可以设置一个用户（除root外的另外用户），",{"type":19,"tag":27,"props":328,"children":329},{},[330],{"type":19,"tag":164,"props":331,"children":333},{"src":332,"alt":167,"loading":168},"https:\u002F\u002Fimg2024.cnblogs.com\u002Fblog\u002F962554\u002F202606\u002F962554-20260624141359589-1329239252.png",[],{"type":19,"tag":27,"props":335,"children":336},{},[337],{"type":25,"value":338},"11.点击开始安装，等待安装完成，提示如图，即表示安装成功。",{"type":19,"tag":27,"props":340,"children":341},{},[342],{"type":19,"tag":164,"props":343,"children":345},{"src":344,"alt":167,"loading":168},"https:\u002F\u002Fimg2024.cnblogs.com\u002Fblog\u002F962554\u002F202606\u002F962554-20260624141459916-990389528.png",[],{"type":19,"tag":27,"props":347,"children":348},{},[349],{"type":25,"value":350}," 12.回车后，自动进入提示登录Linux命令界面，输入root及密码，即可进入系统，再次输入 ip addr,获取当前的服务器IP，",{"type":19,"tag":27,"props":352,"children":353},{},[354],{"type":19,"tag":164,"props":355,"children":357},{"src":356,"alt":167,"loading":168},"https:\u002F\u002Fimg2024.cnblogs.com\u002Fblog\u002F962554\u002F202606\u002F962554-20260624141837916-1012287885.png",[],{"type":19,"tag":27,"props":359,"children":360},{},[361],{"type":25,"value":362}," 13.输入nmtui,打开图形化设置SSH配置项，如图，IPv4 CONFIGURATION，设置Automatic为Manual，填入IP，网关，DNS等参数，按键到OK，即可。",{"type":19,"tag":27,"props":364,"children":365},{},[366],{"type":19,"tag":164,"props":367,"children":369},{"src":368,"alt":167,"loading":168},"https:\u002F\u002Fimg2024.cnblogs.com\u002Fblog\u002F962554\u002F202606\u002F962554-20260624141929661-1395836979.png",[],{"type":19,"tag":27,"props":371,"children":372},{},[373],{"type":25,"value":374}," 14.选择Back，回到主设置界面，",{"type":19,"tag":27,"props":376,"children":377},{},[378],{"type":19,"tag":164,"props":379,"children":381},{"src":380,"alt":167,"loading":168},"https:\u002F\u002Fimg2024.cnblogs.com\u002Fblog\u002F962554\u002F202606\u002F962554-20260624142345326-627353097.png",[],{"type":19,"tag":27,"props":383,"children":384},{},[385],{"type":25,"value":386}," 15.选择Activate a connection，以激活配置。",{"type":19,"tag":27,"props":388,"children":389},{},[390],{"type":19,"tag":164,"props":391,"children":393},{"src":392,"alt":167,"loading":168},"https:\u002F\u002Fimg2024.cnblogs.com\u002Fblog\u002F962554\u002F202606\u002F962554-20260624142416953-682216143.png",[],{"type":19,"tag":27,"props":395,"children":396},{},[397],{"type":25,"value":398}," 16.先暂停激活，再通过按键，选择Activate激活。",{"type":19,"tag":27,"props":400,"children":401},{},[402],{"type":19,"tag":164,"props":403,"children":405},{"src":404,"alt":167,"loading":168},"https:\u002F